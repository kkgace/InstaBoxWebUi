# InstaBox WebUI Console 运行期配置示例
# 复制为部署目录之外的独立文件（如 /data/instabox-console-secrets/.console-env），
# deploy/supervisor-vm.sh 默认从 ENV_FILE 指向的路径 source —— 重部署 rm -rf 不会清掉。
# 敏感文件权限建议 0600。

# ---------- 必填 ----------
# 控制台访问密码。fail-closed：不配置看门狗拒绝启动，防止"静默无保护"上线。
CONSOLE_PASSWORD=change-me-strong-password

# ---------- 网络与安全 ----------
# 监听端口与地址。只绑 127.0.0.1 由 nginx 对外时，客户端无法伪造 XFF 绕过 IP 门
PORT=3010
HOST=127.0.0.1
# IP 放行名单（逗号分隔，支持 IPv4 CIDR 如 203.0.113.0/24；不设=关闭该门）
ALLOW_IPS=
# 控制台对外权威（Host[:Port]），本机 dsh 挂载靠它过 browser-trust fence
DSH_PUBLIC_HOST=console.example.com:8443
# /dsh 内置挂载的上游（本机 dsh web，默认 127.0.0.1:5080）
DSH_UPSTREAM=http://127.0.0.1:5080
# 额外挂载，逗号分隔：/前缀=https://上游
DSH_MOUNTS=
# 额外放行的 WS 目标域后缀（默认已含 *.instabox.sh / *.instabox.tech）
ALLOW_WS_HOSTS=
# 上游 API
INSTABOX_API=https://api.instabox.sh
# 可选：客户端不带 Key 时由服务端注入（部署到机器上收口用）
INSTABOX_API_KEY=

# ---------- 保活探针（server/keepalive.mjs） ----------
KEEPALIVE=1
# use（默认：跟随真实使用）| always（无脑常驻）| off
KEEPALIVE_MODE=use
# 最近一次真实使用距今多少秒内才续 lease（须 < 1800 闲置阈值）
KEEPALIVE_USE_WINDOW=1200
# 续期周期秒
KEEPALIVE_INTERVAL=120
# 单次 lease TTL 秒（30–3600）
KEEPALIVE_LEASE_SEC=600
KEEPALIVE_LEASE_ID=console-keepalive
# 1=对已暂停机器也下 lease（会唤醒它）
KEEPALIVE_WAKE=0
# 1=把学习到的账户 Key 落盘（0600）
KEEPALIVE_PERSIST=1
KEEPALIVE_FILE=/data/instabox-console-secrets/keepalive-keys.json

# ---------- 抢占式暂停（可选，免费版冷却阶梯归零用） ----------
# run 快到期且机器确实空闲时主动 suspend（"无冷却方式收尾" → 冷却阶梯归零）
KEEPALIVE_PREEMPT=0
# run 剩余多少分钟内才考虑抢占
KEEPALIVE_PREEMPT_REMAIN=15
# 空闲多少分钟以上才算"真的没在用"
KEEPALIVE_PREEMPT_IDLE=20
# 最近 CPU 采样都低于该百分比才算空闲
KEEPALIVE_PREEMPT_CPU=5

# ---------- front 代理（可选组件，各自独立进程） ----------
# server/dsh-front.mjs:  PORT=5080 UP=http://127.0.0.1:5081 ALLOW_IPS=203.0.113.0/24 HOST_OVERRIDE=console.example.com:8443
# server/gate-front.mjs: PORT=3018 UP=http://127.0.0.1:3019 ALLOW_IPS=203.0.113.0/24
# server/newapi-front.mjs: PORT=3002 UP=127.0.0.1:3001 NEWAPI_SERVER_TOKEN=sk-...
