[Unit]
Description=DeepSeek Harness web UI (dsh web)
After=network.target

[Service]
ExecStart=/root/.nvm/versions/node/v24.22.3/bin/node /root/.nvm/versions/node/v24.22.3/lib/node_modules/@deepseek-ai/dsh/lib/bin.js --profile web --no-open --port 5080 --public-url https://3000-<machine-id>.instabox.tech/dsh/ --trusted-host 3000-<machine-id>.instabox.tech
WorkingDirectory=/root
User=root
Environment=HOME=/root
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
