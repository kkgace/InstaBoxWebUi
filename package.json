{
  "name": "instabox-ui",
  "version": "1.3.0",
  "type": "module",
  "description": "InstaBox WebUI Console — bring every api.instabox.sh operation into the browser (sandboxes, terminal, desktop VNC, files, ports, SSH, snapshots, secrets, webhooks, monitoring)",
  "license": "MIT",
  "author": "kkgace",
  "homepage": "https://github.com/kkgace/InstaBoxWebUi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkgace/InstaBoxWebUi.git"
  },
  "bugs": {
    "url": "https://github.com/kkgace/InstaBoxWebUi/issues"
  },
  "keywords": [
    "instabox",
    "sandbox",
    "console",
    "webui",
    "react",
    "vite",
    "reverse-proxy",
    "websocket",
    "terminal",
    "vnc"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "lint": "eslint src server",
    "test": "vitest run",
    "gen:catalog": "python scripts/gen_catalog.py",
    "package": "bash scripts/package.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
